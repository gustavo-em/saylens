# Release version used by the Android build. Bump VERSION_CODE for every
# upload to the Play Store; it must be higher than the last one accepted.
VERSION_CODE=1
VERSION_NAME=1.0

# Keeps internal detector metrics out of store builds unless explicitly enabled.
LESINGO_SHOW_DIAGNOSTICS=false

# Upload key used to sign the Play Store bundle. Leave empty to sign with the
# debug key, which works on a device and is rejected by the Play Store.
# The path may be absolute or relative to the repository root.
# Never commit the filled-in .env or the keystore itself.
LESINGO_UPLOAD_STORE_FILE=
LESINGO_UPLOAD_STORE_PASSWORD=
LESINGO_UPLOAD_KEY_ALIAS=
LESINGO_UPLOAD_KEY_PASSWORD=
