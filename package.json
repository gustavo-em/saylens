{
  "name": "spell-for-me",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "android": "react-native run-android",
    "android:release": "cd android && ./gradlew app:installRelease",
    "benchmark:android": "./scripts/benchmark-android.sh 30",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "generate:detector": "cd modules/vision-object-detector && ../../node_modules/.bin/nitrogen",
    "start": "react-native start",
    "test": "jest --runInBand --no-watchman",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-spellforme-object-detector": "file:modules/vision-object-detector",
    "react-native-svg": "^15.15.5",
    "react-native-vision-camera": "5.2.2",
    "react-native-vision-camera-worklets": "5.2.2",
    "react-native-worklets": "0.12.1",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "nitrogen": "0.37.0",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
